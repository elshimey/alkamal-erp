# رابط قاعدة البيانات PostgreSQL
DATABASE_URL=postgres://erp:erp@localhost:5432/alkamal_erp

# حساب مدير النظام الأول (يُستخدم مرة واحدة عند التهيئة)
# اترك كلمة المرور فارغة ليولّد النظام كلمة مرور عشوائية ويعرضها مرة واحدة
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# بيانات المنشأة على الفاتورة المطبوعة
COMPANY_VAT_NUMBER=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS=

# طلب العطل الذي تتجاوز تكلفته التقديرية هذا المبلغ (ريال) يحتاج اعتماد المدير
BREAKDOWN_APPROVAL_LIMIT=5000

# بريد استرجاع كلمة المرور (Gmail: كلمة مرور تطبيق من إعدادات حساب جوجل)
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=
